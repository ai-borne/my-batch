rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membership(batchId) {
      return get(/databases/$(database)/documents/batches/$(batchId)/memberships/$(request.auth.uid));
    }
    function active(batchId) { return signedIn() && membership(batchId).data.status == 'active'; }
    function coordinator(batchId) { return active(batchId) && membership(batchId).data.role == 'coordinator'; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function profileShape(uid) { return request.resource.data.uid == uid && request.resource.data.keys().hasOnly(['uid', 'displayName', 'avatarPath', 'houseId', 'city', 'profession', 'about', 'favouriteSchoolMemory', 'teacherOrActivity', 'socialLinks', 'updatedAt']); }

    match /users/{uid} {
      allow read, create, update: if self(uid);
      allow delete: if false;
    }
    match /batches/{batchId} {
      allow read: if active(batchId);
      allow write: if false;
      match /memberships/{uid} { allow read: if active(batchId); allow write: if false; }
      match /accessRequests/{requestId} {
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.batchId == batchId && request.resource.data.status == 'pending';
        allow read: if signedIn() && (resource.data.uid == request.auth.uid || coordinator(batchId));
        allow update: if signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending' && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
        allow delete: if false;
      }
      match /profiles/{uid} {
        allow read: if active(batchId);
        allow create: if active(batchId) && self(uid) && profileShape(uid);
        allow update: if active(batchId) && self(uid) && profileShape(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarPath', 'city', 'profession', 'about', 'favouriteSchoolMemory', 'teacherOrActivity', 'socialLinks', 'updatedAt']);
        allow delete: if false;
      }
      match /reunion/config { allow read: if active(batchId); allow write: if coordinator(batchId); }
      match /rsvps/{uid} { allow read: if active(batchId); allow write: if false; }
      match /paymentConfig/current { allow read: if active(batchId); allow write: if coordinator(batchId); }
      match /paymentClaims/{claimId} { allow read: if coordinator(batchId); allow write: if false; }
      match /fundSummary/public { allow read: if active(batchId); allow write: if false; }
      match /expenses/{expenseId} { allow read: if coordinator(batchId) || (active(batchId) && resource.data.status == 'approved'); allow write: if coordinator(batchId); }
      match /auditEvents/{eventId} { allow read: if coordinator(batchId); allow write: if false; }
      match /{document=**} { allow read, write: if false; }
    }
  }
}
