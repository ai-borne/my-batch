rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membership(batchId) {
      return get(/databases/$(database)/documents/batches/$(batchId)/memberships/$(request.auth.uid));
    }
    function active(batchId) { return signedIn() && membership(batchId).data.status == 'active'; }
    function coordinator(batchId) { return active(batchId) && membership(batchId).data.role == 'coordinator'; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function userShape(uid) { return request.resource.data.uid == uid && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100 && request.resource.data.email is string && request.resource.data.email.size() <= 320; }
    function validSocialLinks() { return !request.resource.data.keys().hasAny(['socialLinks']) || (request.resource.data.socialLinks is map && request.resource.data.socialLinks.keys().hasOnly(['linkedin', 'instagram', 'website']) && (!request.resource.data.socialLinks.keys().hasAny(['linkedin']) || (request.resource.data.socialLinks.linkedin is string && request.resource.data.socialLinks.linkedin.size() <= 300 && request.resource.data.socialLinks.linkedin.matches('https://.*'))) && (!request.resource.data.socialLinks.keys().hasAny(['instagram']) || (request.resource.data.socialLinks.instagram is string && request.resource.data.socialLinks.instagram.size() <= 300 && request.resource.data.socialLinks.instagram.matches('https://.*'))) && (!request.resource.data.socialLinks.keys().hasAny(['website']) || (request.resource.data.socialLinks.website is string && request.resource.data.socialLinks.website.size() <= 300 && request.resource.data.socialLinks.website.matches('https://.*')))); }
    function profileShape(uid) { return request.resource.data.uid == uid && request.resource.data.keys().hasOnly(['uid', 'displayName', 'memberCode', 'avatarPath', 'houseId', 'city', 'profession', 'about', 'favouriteSchoolMemory', 'teacherOrActivity', 'socialLinks', 'updatedAt']) && validSocialLinks(); }
    function validHouse(value) { return value in ['shivaji', 'nehru', 'karve', 'rana-pratap', 'shastri', 'tilak']; }
    function accessRequestShape() { return request.resource.data.keys().hasOnly(['uid', 'batchId', 'displayName', 'houseId', 'rollNumber', 'passingYear', 'status', 'createdAt', 'updatedAt', 'resubmittedAt', 'rejectionReason', 'rejectedBy', 'rejectedAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.batchId is string && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 100 && request.resource.data.rollNumber is string && request.resource.data.rollNumber.matches('^[A-Za-z0-9-]{1,32}$') && validHouse(request.resource.data.houseId) && request.resource.data.passingYear == 2002; }

    match /users/{uid} {
      allow read: if self(uid);
      allow create: if self(uid) && userShape(uid);
      allow update: if self(uid) && userShape(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }
    match /batches/{batchId} {
      allow read: if active(batchId);
      allow write: if false;
      match /memberships/{uid} { allow read: if self(uid) || active(batchId); allow write: if false; }
      match /accessRequests/{requestId} {
        allow create: if signedIn() && accessRequestShape() && request.resource.data.batchId == batchId && request.resource.data.status == 'pending';
        allow read: if signedIn() && (resource.data.uid == request.auth.uid || coordinator(batchId));
        allow update: if signedIn() && resource.data.uid == request.auth.uid && accessRequestShape() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'houseId', 'rollNumber', 'status', 'updatedAt', 'resubmittedAt']) && ((resource.data.status == 'pending' && request.resource.data.status == 'pending') || (resource.data.status == 'rejected' && request.resource.data.status == 'pending'));
        allow delete: if false;
      }
      match /profiles/{uid} {
        allow read: if active(batchId);
        allow create: if active(batchId) && self(uid) && profileShape(uid) && !request.resource.data.keys().hasAny(['memberCode']);
        allow update: if active(batchId) && self(uid) && profileShape(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarPath', 'city', 'profession', 'about', 'favouriteSchoolMemory', 'teacherOrActivity', 'socialLinks', 'updatedAt']);
        allow delete: if false;
      }
      match /reunion/config { allow read: if active(batchId); allow write: if coordinator(batchId); }
      match /reunionSchedule/{eventId} { allow read: if active(batchId); allow write: if coordinator(batchId); }
      match /reunionContacts/{contactId} { allow read: if active(batchId); allow write: if coordinator(batchId); }
      match /rsvps/{uid} { allow read: if active(batchId); allow write: if false; }
      match /paymentConfig/current {
        allow read: if active(batchId);
        allow create, update: if coordinator(batchId) && request.resource.data.keys().hasOnly(['defaultFamilyAmountPaise', 'targetPaise', 'currency', 'upiId', 'qrStoragePath', 'accountLabel', 'contributionHeads', 'updatedBy', 'updatedAt']) && request.resource.data.currency == 'INR' && request.resource.data.upiId is string && request.resource.data.upiId.size() <= 120 && request.resource.data.defaultFamilyAmountPaise is int && request.resource.data.defaultFamilyAmountPaise >= 0 && request.resource.data.targetPaise is int && request.resource.data.targetPaise >= 0 && request.resource.data.qrStoragePath is string && request.resource.data.qrStoragePath.matches('batches/' + batchId + '/reunion/qr/.*') && request.resource.data.contributionHeads is list && request.resource.data.contributionHeads.size() > 0 && request.resource.data.contributionHeads.size() <= 12 && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
      match /paymentClaims/{claimId} { allow read: if coordinator(batchId); allow write: if false; }
      match /fundSummary/public { allow read: if active(batchId); allow write: if false; }
      match /expenses/{expenseId} { allow read: if coordinator(batchId) || (active(batchId) && resource.data.status == 'approved'); allow write: if false; }
      match /auditEvents/{eventId} { allow read, write: if false; }
      match /posts/{postId} {
        allow read: if active(batchId) && resource.data.status == 'visible';
        allow write: if false;
        match /comments/{commentId} { allow read: if active(batchId) && get(/databases/$(database)/documents/batches/$(batchId)/posts/$(postId)).data.status == 'visible' && resource.data.status == 'visible'; allow write: if false; }
        match /likes/{uid} { allow read: if active(batchId) && get(/databases/$(database)/documents/batches/$(batchId)/posts/$(postId)).data.status == 'visible'; allow write: if false; }
      }
      match /albums/{albumId} { allow read: if active(batchId) && resource.data.status == 'visible'; allow write: if false; }
      match /reports/{reportId} { allow read: if coordinator(batchId); allow write: if false; }
      match /notifications/{uid}/items/{notificationId} { allow read: if self(uid) && active(batchId); allow write: if false; }
      match /{document=**} { allow read, write: if false; }
    }
  }
}
