# Copy to .env.local. Never commit production credentials or administrator email addresses.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Which environment the app runs in: local | staging | production.
#   local      → Firebase Emulator Suite (no App Check, emulator ports)
#   staging    → deployed non-production Firebase project (App Check on)
#   production → the live Firebase project (App Check on)
# Legacy: VITE_USE_FIREBASE_EMULATORS=true is still honoured and maps to 'local'.
VITE_APP_ENV=local
